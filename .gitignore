# ==============================================================================
# .gitignore for Unity VRChat World Projects (UdonSharp / VCC / VPM)
# ==============================================================================

# ------------------------------------------------------------------------------
# Unity Cache & Generated Folders
# ------------------------------------------------------------------------------
.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
ExportedObj/
/UIElementsSchema/
/[Aa]ssets/[Ss]ceneDependencyCache*

# ------------------------------------------------------------------------------
# VRChat SDK & Udon / UdonSharp Generated Artifacts
# ------------------------------------------------------------------------------
# Serialized Udon assembly caches generated automatically by Udon / UdonSharp.
# Tracking these causes constant git churn, massive diffs, and merge conflicts.
/[Aa]ssets/[Ss]erializedUdonPrograms/
/[Aa]ssets/[Ss]erializedUdonPrograms.meta

# Temporary VRChat build / packaging folders
/[Aa]ssets/[Vv][Rr][Cc]hat[Bb]uild[Tt]emp/
/[Aa]ssets/[Vv][Rr][Cc]hat[Bb]uild[Tt]emp.meta
/[Aa]ssets/VRCSDK/Dependencies/VRChat/Env/

# Legacy SDK asset imports (if imported manually into Assets instead of Packages)
/[Aa]ssets/VRCSDK/
/[Aa]ssets/VRCSDK.meta
/[Aa]ssets/VRChat Examples/
/[Aa]ssets/VRChat Examples.meta
# Note: Do NOT ignore Assets/UdonSharp/ if you store custom scripts in Assets!

# VRChat World & Avatar export bundles
*.vrcw
*.vrcw.meta
*.vrca
*.vrca.meta

# ClientSim & VRChat local run logs
output_log.txt
output_log_*.txt
VRChat_*.log

# ------------------------------------------------------------------------------
# VRChat Creator Companion / VPM (VRChat Package Manager)
# ------------------------------------------------------------------------------
# The VPM Resolver creates Packages/.gitignore which ignores downloaded packages
# while keeping Packages/manifest.json, Packages/packages-lock.json,
# Packages/vpm-manifest.json, and Packages/com.vrchat.core.vpm-resolver/.
# Root fallback rules (safe alongside Packages/.gitignore):
/Packages/com.vrchat.*
!/Packages/com.vrchat.core.vpm-resolver/

# ------------------------------------------------------------------------------
# VRChat World Tools & Community Addons
# ------------------------------------------------------------------------------
# VRWorldToolkit build reports
/[Aa]ssets/VRWorldToolkit/BuildReports/
/[Aa]ssets/VRWorldToolkit/BuildReports.meta
/BuildReports/

# Bakery GPU Lightmapper temp cache (do not ignore final baked lightmaps!)
/[Bb]akery[Tt]emp/
/[Bb]akery[Tt]emp.meta

# CyanTrigger generated program caches
/[Aa]ssets/CyanTrigger/Generated/
/[Aa]ssets/CyanTrigger/Generated.meta

# UdonSharp backup files
*.asmdef.udon_backup

# ------------------------------------------------------------------------------
# 3D Modeling & DCC Auto-Saves (Blender, Photoshop, Substance)
# ------------------------------------------------------------------------------
# Blender auto-save and backup files (*.blend files remain tracked)
*.blend1
*.blend1.meta
*.blend2
*.blend2.meta

# General backup & autosave files
*.bak
*.bak.meta
*.tmp
*~

# ------------------------------------------------------------------------------
# IDEs, Code Editors & Solution Files
# ------------------------------------------------------------------------------
# Autogenerated Visual Studio / Rider / MonoDevelop solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
.consulo/

# Unity3D generated meta files for compiler outputs
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Visual Studio cache directory
.vs/

# JetBrains Rider
.idea/
*.DotSettings.user
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio Code: ignore local workspace caches, keep shared config
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ------------------------------------------------------------------------------
# Builds, Mobile & Addressables
# ------------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app
.gradle/
crashlytics-build.properties

# Addressables default ignores
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# PlayMode / TestRunner auto-generated scenes
InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# ------------------------------------------------------------------------------
# Crash Reports & Diagnostic Logs
# ------------------------------------------------------------------------------
sysinfo.txt
*.log
mono_crash.*
*.stackdump

# ------------------------------------------------------------------------------
# Sensitive Credentials & Secrets
# ------------------------------------------------------------------------------
# Prevent accidental leaks of VRChat or signing credentials
*creds*.json
vrc-creds.json
*.keystore
*.pfx

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
[Tt]humbs.db
[Ee]hthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ------------------------------------------------------------------------------
# Antigravity IDE (Unity Plugin)
# ------------------------------------------------------------------------------
# Ignore Antigravity IDE Plugin
/[Aa]ssets/Plugins/AntigravityIDE/
/[Aa]ssets/Plugins/AntigravityIDE.meta